# Backend environment. Copy to .env and fill in.

# Local Postgres from docker-compose
DATABASE_URL=postgresql+psycopg://uatx:uatx_dev@localhost:5432/uatx_wechat

# Clerk
# Get these from https://dashboard.clerk.com → your app → API Keys / JWT Templates
CLERK_JWKS_URL=https://your-clerk-frontend-api.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-frontend-api.clerk.accounts.dev
CLERK_AUDIENCE=

# Allowed email domains (comma-separated). Empty = any domain accepted, which
# is the current policy (incoming students without a school email should still
# be able to buy books). Set e.g. ALLOWED_EMAIL_DOMAINS=student.uaustin.org if
# you want to lock down to UATX-only.
ALLOWED_EMAIL_DOMAINS=

# Set to "dev" locally to allow CORS to the Vite dev server.
APP_ENV=dev

# Supabase Storage for listing photos. Leave empty to disable the upload
# endpoint (returns 503). SUPABASE_SERVICE_KEY is the "service_role" key
# in Supabase dashboard → Project Settings → API. Treat as a secret —
# unlike the publishable Clerk key, this one is NOT safe to share.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images
